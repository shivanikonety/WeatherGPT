# ==========================================
# WeatherGPT — Environment Configuration Template
# ==========================================
# Copy this file to '.env' and populate with your actual keys.
# Do NOT commit '.env' to version control.

# Application Settings
APP_NAME=WeatherGPT
APP_VERSION=2.0.0
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated list or * for all)
ALLOWED_ORIGINS=*

# AI Weather Intelligence (Groq Cloud API)
# Get your free API key at: https://console.groq.com/keys
# If left blank, WeatherGPT automatically falls back to deterministic rule-based intelligence.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# External Weather & Geocoding Endpoints (Open-Meteo)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# In-Memory Cache TTL (Seconds)
WEATHER_CACHE_TTL_SECONDS=300
GEOCODE_CACHE_TTL_SECONDS=86400

# Default Location Settings
DEFAULT_CITY=Hyderabad
DEFAULT_LATITUDE=17.3850
DEFAULT_LONGITUDE=78.4867
